{
  "name": "portfolio-cloud",
  "version": "0.0.1",
  "description": "Serverless cloud automation for portfolio and blog (AWS Lambda)",
  "scripts": {
    "dev:og": "ts-node src/dev/run-og.ts",
    "dev:og:preview": "ts-node src/dev/render-og.ts",
    "dev:notify": "ts-node src/dev/run-notify.ts",
    "dev:subscribe": "ts-node src/dev/run-subscribe.ts",
    "dev:unsubscribe": "ts-node src/dev/run-unsubscribe.ts",
    "dev:release": "ts-node src/dev/run-release.ts",
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\" \"vitest.config.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "ci": "npm run lint && npm run test:run && npm run build",
    "sam:validate": "sam validate --lint --template-file template.yaml",
    "sam:build": "sam build --template-file template.yaml",
    "sam:deploy:guided": "sam deploy --guided --template-file template.yaml"
  },
  "keywords": [
    "cloud",
    "lambdas",
    "aws",
    "serverless"
  ],
  "homepage": "https://github.com/matigaleanodev/portfolio-cloud#readme",
  "bugs": {
    "url": "https://github.com/matigaleanodev/portfolio-cloud/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matigaleanodev/portfolio-cloud.git"
  },
  "license": "ISC",
  "author": "Matias Galeano <contacto@matiasgaleano.com.ar> (https://www.matiasgaleano.com.ar/)",
  "type": "commonjs",
  "main": "index.js",
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.57.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1004.0",
    "@aws-sdk/client-s3": "^3.1004.0",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^17.3.1",
    "resend": "^6.9.3",
    "satori": "^0.25.0"
  }
}
